  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "sequelize-cli db:migrate --config db/config.js --migrations-path db/migrations",
    "migrate:undo": "sequelize-cli db:migrate:undo --config db/config.js --migrations-path db/migrations",
    "migration:new": "sequelize-cli migration:generate --migrations-path db/migrations --name",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
